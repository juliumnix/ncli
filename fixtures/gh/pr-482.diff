diff --git a/src/billing/calcTotal.ts b/src/billing/calcTotal.ts
index 0101010..0202020 100644
--- a/src/billing/calcTotal.ts
+++ b/src/billing/calcTotal.ts
@@ -1,7 +1,14 @@
 export function calcTotal(item, customer) {
   let total = item.price
-  if (item.discount) total -= item.discount
+  const kind = customer?.kind
+  const eligible = kind === 'member'
+  if (item.discount && eligible) {
+    total = applyDiscount(total, item.discount)
+  }
+  if (total < 0) total = 0
   total = applyTax(total)
   return render(total)
 }
diff --git a/src/billing/discount.ts b/src/billing/discount.ts
index 1111111..2222222 100644
--- a/src/billing/discount.ts
+++ b/src/billing/discount.ts
@@ -10,8 +10,14 @@ export function applyDiscount(total, discount) {
   if (discount <= 0) return total
-  return total - discount
+  const capped = Math.min(discount, total)
+  return Math.max(0, total - capped)
 }
